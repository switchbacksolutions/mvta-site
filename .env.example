# Copy this file to .env and fill in values for local development.
# Never commit .env to version control.

# Stripe — online membership payments
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — from https://dashboard.stripe.com/webhooks
# Point the webhook at: https://your-site.netlify.app/.netlify/functions/stripe-webhook
# Events to send: checkout.session.completed, invoice.paid
STRIPE_WEBHOOK_SECRET=whsec_...
# Customer portal login page — Stripe Dashboard → Settings → Billing → Customer portal.
# Test and live mode have different URLs. Read at build time, so redeploy after a change.
PUBLIC_STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/...

# Email notifications for payments (uses Resend — https://resend.com, free tier available)
RESEND_API_KEY=re_...
# Who receives the payment notification email (e.g. the treasurer)
TREASURER_EMAIL=treasurer@meadowvistatrails.org
# The "from" address — must be a verified Resend sender domain
FROM_EMAIL=MVTA Website <noreply@meadowvistatrails.org>
