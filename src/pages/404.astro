---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page Not Found" description="The page you were looking for does not exist." noindex>
  <main class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <p class="text-sm font-semibold uppercase tracking-wide text-brand-600 dark:text-brand-400">404</p>
    <h1 class="mt-2 text-4xl font-bold text-gray-900 dark:text-white">Page not found</h1>
    <p class="mt-4 text-lg text-gray-600 dark:text-gray-400">
      We could not find that page. It may have moved when the site was rebuilt.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/" class="btn-primary">Go to the home page</a>
      <a href="/trails" class="btn-secondary">Browse trails</a>
    </div>
  </main>
</BaseLayout>
